# Разрешаем Метрике и Вебвизору открывать сайт в iframe
<IfModule mod_headers.c>
    SetEnvIfNoCase Referer "^https?://([^/]+\.)?(troy-hotel\.ru|webvisor\.com|metri[ck]a\.yandex\.(com|ru|by|com\.tr))/" allowedReferer
    Header set X-Frame-Options "SAMEORIGIN" env=!allowedReferer
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Любой запрос к несуществующему файлу / папке перенаправляем на Nuxt сервер
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
